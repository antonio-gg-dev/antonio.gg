{
  "name": "antonio.gg",
  "description": "My professional software development and 3D printing portfolio.",
  "repository": "git@github.com:antonio-gg-dev/antonio.gg.git",
  "author": "Antonio Gonzalez Gea <dev@antonio.gg>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vitepress dev --port 5100",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "stories": "storybook dev -p 6100 --no-open",
    "stories:build": "storybook build",
    "stories:publish": "npx chromatic -b stories:build --no-interactive",
    "lint": "eslint --ext .js,.ts,.vue .",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "sa": "tsc",
    "all:fix": "npm run lint:fix && npm run format:fix",
    "pre-commit": "npm run sa && npm run lint && npm run format && npm run build",
    "pre-commit:install": "echo 'npm run pre-commit' > .git/hooks/pre-commit && chmod u+x .git/hooks/pre-commit",
    "pre-push": "npm run stories:publish",
    "pre-push:install": "echo 'npm run pre-push' > .git/hooks/pre-push && chmod u+x .git/hooks/pre-push",
    "postinstall": "npm run pre-commit:install && npm run pre-push:install"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@eslint/js": "^9.39.5",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "chromatic": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-config-love": "^155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "markdown-it": "^15.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.103.1",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {}
    }
  }
}
